# Google Maps Platform key with "Maps JavaScript API" and "Places API (New)" enabled.
# Restrict it to your website's domain (HTTP referrers) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Paratha Rasoi's Google Place ID. If empty, the place is found by name/address.
VITE_GOOGLE_PLACE_ID=ChIJI0A2MrcNrjsRTgmZlLKGnZ4

# Local SQLite database file (created automatically). Default: data/paratha-rasoi.db
DB_PATH=

# Secret token to read saved reservations/messages via GET /api/reservations and /api/messages.
# Leave empty to keep those routes disabled.
ADMIN_TOKEN=

# WhatsApp OTP for table bookings (Meta WhatsApp Cloud API). Leave the token empty while testing:
# the OTP is then printed in the server terminal instead of sent. Setup steps are in readme.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name and language of your approved "Authentication" message template.
WHATSAPP_OTP_TEMPLATE=booking_otp
WHATSAPP_TEMPLATE_LANG=en
